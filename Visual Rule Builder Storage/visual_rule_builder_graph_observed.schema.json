{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/GordonThelander/hubitat_dev_utililities/Visual%20Rule%20Builder%20Storage/visual_rule_builder_graph_observed.schema.json",
  "title": "Observed Hubitat Visual Rule Builder graph envelope",
  "description": "Permissive schema for the graph shape observed on Hubitat platform 2.5.1.152. This is not an official Hubitat contract.",
  "type": "object",
  "required": ["version", "nodes", "edges"],
  "properties": {
    "version": { "type": "integer", "minimum": 1 },
    "nodes": {
      "type": "array",
      "items": { "$ref": "#/$defs/node" }
    },
    "edges": {
      "type": "array",
      "items": { "$ref": "#/$defs/edge" }
    }
  },
  "additionalProperties": true,
  "$defs": {
    "node": {
      "type": "object",
      "required": ["id", "kind", "type", "config"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "kind": { "type": "string", "minLength": 1 },
        "type": { "type": "string", "minLength": 1 },
        "config": { "type": "object" }
      },
      "additionalProperties": true
    },
    "edge": {
      "type": "object",
      "required": ["from", "to", "port"],
      "properties": {
        "from": { "type": "string", "minLength": 1 },
        "to": { "type": "string", "minLength": 1 },
        "port": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": true
    }
  }
}

